---
import { siteContent } from "../../../content/siteContent";

const { hero } = siteContent;
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-warm-100 via-warm-50 to-warm-100 overflow-hidden"
>
  <!-- A brief noren welcome: decorative, confined to the hero, never blocks input. -->
  <div class="noren" aria-hidden="true">
    <div class="noren-panel noren-left"><span>ともちゃん家</span></div>
    <div class="noren-panel noren-right"><span>いらっしゃいませ</span></div>
  </div>

  <!-- Background decorative elements -->
  <div
    class="absolute top-10 right-10 w-72 h-72 bg-accent-light rounded-full opacity-20 blur-3xl hero-float"
  >
  </div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-warm-200 rounded-full opacity-10 blur-3xl">
  </div>

  <!-- Hero overlay pattern -->
  <div class="absolute inset-0 opacity-5 hero-pattern"></div>

  <div class="winter-stars" aria-hidden="true">
    <span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 pt-36 pb-12 max-w-4xl mx-auto">
    <!-- Animated badge -->
    <a
      href="#shop-anniversary"
      class="winter-welcome inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full shadow-soft animate-fade-in"
    >
      <img src="/cat-face.webp" alt="Tomochan" class="w-5 h-5 object-contain" />
      <span class="text-sm font-bold">祝・2周年 · 12/11・12・13 記念イベント</span>
    </a>

    <p class="winter-kicker">SEASON’S GREETINGS <span aria-hidden="true">✦</span> 2026–2027</p>

    <!-- Main title with staggered animation -->
    <h1 class="hero-title mb-4 animate-fade-up">
      {hero.title}
    </h1>

    <!-- Subtitle -->
    <p class="text-xl md:text-2xl text-warm-700 mb-8 animate-fade-up">
      {hero.subtitle}
    </p>

    <!-- Feature badges -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {
        hero.badges.map((badge, i) => (
          <span
            class="px-4 py-2 rounded-full bg-white shadow-softer text-sm font-semibold text-warm-800 animate-fade-up"
            style={{ animationDelay: `${i * 0.1}s` }}
          >
            {badge}
          </span>
        ))
      }
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      {
        hero.ctas.map((cta) => (
          <a
            href={cta.href}
            class={`px-8 py-4 rounded-lg font-bold text-lg hero-cta transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${
              cta.primary
                ? "bg-accent hover:bg-accent-dark text-warm-900 shadow-soft hover:shadow-lg"
                : "border-2 border-warm-800 text-warm-900 hover:bg-warm-100"
            }`}
          >
            {cta.label}
          </a>
        ))
      }
    </div>

    <!-- Floating cat emoji -->
    <div class="absolute top-20 right-20 opacity-40 hero-cat-float hidden md:block">
      <img src="/cat-face.webp" alt="Tomochan" class="w-24 h-24 object-contain" />
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 md:bottom-8 left-1/2 -translate-x-1/2 z-10 hidden md:flex flex-col items-center gap-2"
  >
    <span class="text-sm text-warm-700 font-medium">スクロール</span>
    <div class="hero-scroll-cue">
      <span class="text-2xl">↓</span>
    </div>
  </div>
</section>

<style>
  :global(.izakaya-home) #home {
    background:
      radial-gradient(ellipse at 0% 0%, #4263471c, transparent 42%),
      radial-gradient(ellipse at 100% 100%, #7b414b14, transparent 40%),
      linear-gradient(135deg, #f5f1e8, #fffaf0 48%, #f5f1e8);
    border-bottom-color: #b79a5e;
  }

  :global(.izakaya-home) #home::after {
    border-color: #ba975d80;
    box-shadow: inset 0 0 0 5px #fffaf033;
  }

  .winter-welcome {
    border: 1px solid #bc9659;
    color: #fff8e8;
    background: #63343c;
  }

  :global(.izakaya-home) #home .winter-kicker {
    margin: -0.25rem 0 1.5rem;
    color: #6a5935;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .winter-kicker span {
    margin-inline: 0.3rem;
    color: #9b7740;
  }

  .winter-stars {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: #b99554;
  }

  .winter-stars span {
    position: absolute;
    font-size: clamp(1.3rem, 2vw, 2rem);
  }

  .winter-stars span:nth-child(1) {
    top: 22%;
    left: 9%;
  }

  .winter-stars span:nth-child(2) {
    top: 33%;
    right: 11%;
    font-size: 3rem;
  }

  .winter-stars span:nth-child(3) {
    bottom: 20%;
    left: 13%;
  }

  .winter-stars span:nth-child(4) {
    bottom: 14%;
    right: 14%;
  }

  .winter-stars span:nth-child(5) {
    top: 15%;
    right: 25%;
    font-size: 1rem;
  }

  @media (max-width: 767px) {
    .winter-stars span:nth-child(2),
    .winter-stars span:nth-child(3) {
      display: none;
    }

    .winter-stars span:nth-child(1) {
      top: 18%;
      left: 8%;
    }

    .winter-stars span:nth-child(4) {
      bottom: 8%;
      right: 12%;
    }

    :global(.izakaya-home) #home .winter-kicker {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }
  }
</style>
