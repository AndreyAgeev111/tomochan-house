---
interface Props {
  event: {
    title: string;
    name: string;
    date: string;
    description: string;
    image: string;
    imageWidth: number;
    imageHeight: number;
    details: ReadonlyArray<{ icon: string; label: string; value: string }>;
    cta: { label: string; href: string };
  };
}

const { event } = Astro.props;
const confettiColors = ["#bd5779", "#e89eb6", "#d5a342", "#fff8eb", "#8b586e"];
// Deterministic positions keep the server-rendered celebration light and repeatable.
const confetti = Array.from({ length: 48 }, (_, index) => ({
  left: (index * 37 + 7) % 100,
  drift: ((index * 43) % 180) - 90,
  delay: (index % 8) * 0.09,
  duration: 2.5 + (index % 5) * 0.18,
  rotation: 180 + ((index * 67) % 540),
  color: confettiColors[index % confettiColors.length],
}));
---

<article
  id="birthday-event-card"
  class="birthday-card"
  aria-labelledby="birthday-event-title"
  data-birthday-card
>
  <div class="birthday-topline">
    <span aria-hidden="true">✦</span>
    <span>A SPECIAL CELEBRATION AT ともちゃん家</span>
    <span aria-hidden="true">✦</span>
  </div>

  <div class="birthday-layout">
    <div class="birthday-poster-wrap">
      <div class="birthday-poster-frame">
        <img
          src={event.image}
          alt={`${event.title}のポスター`}
          width={event.imageWidth}
          height={event.imageHeight}
          loading="lazy"
          decoding="async"
          class="birthday-poster"
        />
      </div>
      <p class="birthday-poster-caption">Food · Drink · Karaoke · Good Time</p>
    </div>

    <div class="birthday-copy" data-birthday-stage>
      <div class="birthday-confetti" aria-hidden="true">
        {
          confetti.map((piece, index) => (
            <i
              class:list={["birthday-confetti-piece", { "is-round": index % 4 === 0 }]}
              style={`--left:${piece.left}%;--drift:${piece.drift}px;--delay:${piece.delay}s;--duration:${piece.duration}s;--rotation:${piece.rotation}deg;--color:${piece.color}`}
            />
          ))
        }
      </div>
      <div class="birthday-fanfare" aria-hidden="true">
        <span class="birthday-fanfare-spark">✧</span>
        <svg class="birthday-trumpet birthday-trumpet-left" viewBox="0 0 96 64" fill="none">
          <path
            d="M12 30h34l30-15v36L46 36H12z"
            fill="#edc76e"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"></path>
          <path
            d="M76 15h7v36h-7zM12 27H5v12h7M25 36v12c0 10 25 10 25 0v-9M28 23v7m10-7v7m-13-7h6m4 0h6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            class="birthday-trumpet-rays"
            d="m89 16 5-5m-5 21h6m-6 16 5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <span class="birthday-fanfare-label">みんなでお祝いしよう</span>
        <svg class="birthday-trumpet birthday-trumpet-right" viewBox="0 0 96 64" fill="none">
          <path
            d="M12 30h34l30-15v36L46 36H12z"
            fill="#edc76e"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"></path>
          <path
            d="M76 15h7v36h-7zM12 27H5v12h7M25 36v12c0 10 25 10 25 0v-9M28 23v7m10-7v7m-13-7h6m4 0h6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            class="birthday-trumpet-rays"
            d="m89 16 5-5m-5 21h6m-6 16 5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <span class="birthday-fanfare-spark">✧</span>
      </div>

      <div class="birthday-heading">
        <span class="birthday-balloon birthday-balloon-left" aria-hidden="true"></span>
        <p class="birthday-name" aria-hidden="true">{event.name}<span>Happy Birthday</span></p>
        <span class="birthday-balloon birthday-balloon-right" aria-hidden="true"></span>
      </div>

      <h3 id="birthday-event-title" class="birthday-title">
        <span class="sr-only">{event.name}の</span>{event.title}
      </h3>
      <p class="birthday-date"><span aria-hidden="true">🎂</span>{event.date}</p>
      <p class="birthday-description">{event.description}</p>

      <dl class="birthday-details">
        {
          event.details.map((detail) => (
            <div class="birthday-detail">
              <dt>
                <span aria-hidden="true">{detail.icon}</span>
                {detail.label}
              </dt>
              <dd>{detail.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="birthday-actions">
        <a href={event.cta.href} target="_blank" rel="noopener noreferrer" class="birthday-cta">
          {event.cta.label}<span aria-hidden="true">↗</span>
        </a>
        <button class="birthday-celebrate" type="button" data-birthday-celebrate hidden>
          <span aria-hidden="true">🎉</span>お祝いする
        </button>
      </div>
      <p class="birthday-wish" data-birthday-wish aria-live="polite" aria-atomic="true">
        素敵な一年になりますように。
      </p>
    </div>
  </div>
</article>

<script>
  import { initBirthdayCelebration } from "../../../utils/birthdayCelebration";
  initBirthdayCelebration();
</script>

<style>
  .birthday-card {
    --birthday-rose: #93425f;
    --birthday-ink: #603c44;
    position: relative;
    isolation: isolate;
    margin-bottom: 3rem;
    overflow: hidden;
    border: 1px solid #e6c4c8;
    border-radius: 1.5rem;
    color: var(--birthday-ink);
    background:
      radial-gradient(ellipse at 95% 8%, #f6d9e29c, transparent 48%),
      radial-gradient(ellipse at 0% 100%, #efcc9333, transparent 45%), #fff9f3;
    box-shadow: 0 14px 42px #753e4a12;
    scroll-margin-top: 6rem;
  }

  .birthday-topline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e6c4c880;
    color: #925166;
    background: #fff8f5a6;
  }

  .birthday-topline span {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-align: center;
  }

  .birthday-topline span:first-child,
  .birthday-topline span:last-child {
    color: #b2873a;
    font-size: 1rem;
  }

  .birthday-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .birthday-poster-wrap {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
  }

  .birthday-poster-frame {
    padding: 7px;
    border: 1px solid #d9b692;
    border-radius: 0.75rem;
    background: #fffaf1;
    box-shadow: 0 12px 30px #603c4426;
  }

  .birthday-poster {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.35rem;
  }

  .birthday-poster-caption {
    margin-top: 1rem;
    color: #986e65;
    font-family: Georgia, serif;
    font-size: 0.8rem;
    font-style: italic;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .birthday-copy {
    position: relative;
    isolation: isolate;
    min-width: 0;
  }

  .birthday-fanfare {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: #a7792d;
  }

  .birthday-fanfare-label {
    color: #93425f;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .birthday-trumpet {
    width: clamp(2.5rem, 5vw, 3.75rem);
    flex-shrink: 0;
    transform-origin: center;
  }

  .birthday-trumpet-left {
    transform: rotate(-12deg);
  }

  .birthday-trumpet-right {
    transform: scaleX(-1) rotate(-12deg);
  }

  .birthday-fanfare-spark {
    font-size: 1.4rem;
  }

  .birthday-heading {
    position: relative;
    padding: 0.5rem 2rem 1.5rem;
    text-align: center;
  }

  .birthday-name {
    color: var(--birthday-rose);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 7vw, 5.25rem);
    line-height: 1;
    letter-spacing: 0.045em;
    text-shadow: 0 2px #fff;
  }

  .birthday-name span {
    display: block;
    margin-top: 0.4rem;
    color: #a7792d;
    font-size: clamp(1.25rem, 3vw, 1.8rem);
    font-style: italic;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .birthday-balloon {
    position: absolute;
    top: 1.5rem;
    width: 1.75rem;
    height: 2.15rem;
    border: 1px solid #e6b4c1;
    border-radius: 50% 50% 46% 46%;
    background: radial-gradient(circle at 32% 28%, #fff9, transparent 30%), #f1c2d1;
  }

  .birthday-balloon::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    width: 0.6rem;
    height: 2.6rem;
    border-left: 1px solid #c49b85;
    border-radius: 50%;
  }

  .birthday-balloon-left {
    left: 0;
    transform: rotate(-16deg);
  }

  .birthday-balloon-right {
    right: 0;
    top: 0.6rem;
    transform: rotate(16deg);
    border-color: #e0c780;
    background: radial-gradient(circle at 32% 28%, #fff9, transparent 30%), #f0dca2;
  }

  .birthday-title {
    margin-bottom: 0.85rem;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.55;
    text-align: center;
  }

  .birthday-date {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: fit-content;
    margin: 0 auto 1.5rem;
    padding: 0.65rem 1.2rem;
    border: 1px solid #e4b8c5;
    border-radius: 999px;
    color: #893654;
    background: #f9e8ee;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
  }

  .birthday-description {
    line-height: 1.9;
    white-space: pre-line;
  }

  .birthday-details {
    display: grid;
    gap: 1rem;
    margin-block: 1.75rem;
    padding-block: 1.5rem;
    border-block: 1px solid #dfcbb980;
  }

  .birthday-detail dt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .birthday-detail dt span {
    font-size: 1.1rem;
  }

  .birthday-detail dd {
    padding-left: 1.7rem;
    color: #80605c;
    font-size: 0.875rem;
    line-height: 1.65;
    white-space: pre-line;
  }

  .birthday-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .birthday-cta,
  .birthday-celebrate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--birthday-rose);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .birthday-cta {
    flex: 1 1 auto;
    color: white;
    background: var(--birthday-rose);
    box-shadow: 0 4px 12px #93425f1a;
  }

  .birthday-cta:hover {
    background: #78324c;
  }

  .birthday-celebrate {
    color: #893654;
    background: #fffaf6;
  }

  .birthday-celebrate:hover {
    background: #f9e8ee;
  }

  .birthday-celebrate[hidden] {
    display: none;
  }

  .birthday-cta:focus-visible,
  .birthday-celebrate:focus-visible {
    outline: 3px solid #93425f;
    outline-offset: 4px;
  }

  .birthday-wish {
    min-height: 2.8em;
    margin-top: 1.25rem;
    color: #93425f;
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  .birthday-confetti {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .birthday-confetti-piece {
    position: absolute;
    top: -20px;
    left: var(--left);
    width: 7px;
    height: 13px;
    opacity: 0;
    background: var(--color);
  }

  .birthday-confetti-piece.is-round {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-celebrating .birthday-confetti-piece {
      animation: birthday-confetti-fall var(--duration) var(--delay) ease-in forwards;
    }

    .is-celebrating .birthday-trumpet-left {
      animation: birthday-fanfare 650ms ease-in-out 3;
    }

    .is-celebrating .birthday-trumpet-right {
      animation: birthday-fanfare-right 650ms ease-in-out 3;
    }

    .is-celebrating .birthday-balloon-left {
      animation: birthday-balloon 1.4s ease-in-out 2;
    }

    .is-celebrating .birthday-balloon-right {
      animation: birthday-balloon-right 1.4s 150ms ease-in-out 2;
    }

    .is-celebrating .birthday-fanfare-spark {
      animation: birthday-spark 900ms ease-in-out 3;
    }
  }

  @keyframes birthday-confetti-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, -10px, 0) rotate(0);
    }
    8%,
    70% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), var(--birthday-fall-distance, 800px), 0)
        rotate(var(--rotation));
    }
  }

  @keyframes birthday-fanfare {
    50% {
      transform: translateY(-4px) rotate(-22deg);
    }
  }

  @keyframes birthday-fanfare-right {
    50% {
      transform: translateY(-4px) scaleX(-1) rotate(-22deg);
    }
  }

  @keyframes birthday-balloon {
    50% {
      transform: translateY(-12px) rotate(-7deg);
    }
  }

  @keyframes birthday-balloon-right {
    50% {
      transform: translateY(-12px) rotate(7deg);
    }
  }

  @keyframes birthday-spark {
    50% {
      opacity: 0.45;
      transform: scale(1.2);
    }
  }

  @media (max-width: 767px) {
    .birthday-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .birthday-copy {
      max-width: 32rem;
      margin-inline: auto;
    }

    .birthday-heading {
      max-width: 25rem;
      margin-inline: auto;
    }

    .birthday-name {
      font-size: clamp(3.5rem, 14vw, 5rem);
    }

    .birthday-fanfare-label {
      font-size: 0.8rem;
    }

    .birthday-trumpet {
      width: 3rem;
    }

    .birthday-topline span {
      font-size: 0.55rem;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .birthday-confetti {
      display: none;
    }
  }

  @media print {
    .birthday-confetti,
    .birthday-celebrate {
      display: none;
    }
  }
</style>
