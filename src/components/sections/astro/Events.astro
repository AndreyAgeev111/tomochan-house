---
import SectionTitle from "../../common/astro/SectionTitle.astro";
import ScrollReveal from "../../common/astro/ScrollReveal.astro";
import Calendar from "../react/Calendar";
import SeasonalAnnouncements from "./SeasonalAnnouncements.astro";
import GolfTournamentAnnouncement from "../../golf/astro/GolfTournamentAnnouncement.astro";
import { siteContent } from "../../../content/siteContent";

const { events } = siteContent;
---

<section id="events" class="py-12 md:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <SectionTitle title="営業カレンダー・イベント" subtitle={events.intro} />

    <SeasonalAnnouncements />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 mb-8 md:mb-12">
      <ScrollReveal>
        <div>
          <h3 class="text-xl md:text-2xl font-bold text-warm-900 mb-4 md:mb-6">
            イベントのお知らせ
          </h3>
          <div class="space-y-3 md:space-y-4">
            {
              events.monthlyEvents.map((event) => {
                const href = "href" in event ? event.href : undefined;
                const Tag = href ? "a" : "div";
                const isBirthday = "theme" in event && event.theme === "birthday";
                return (
                  <Tag
                    href={href}
                    class={`flex gap-3 md:gap-4 p-3 md:p-4 rounded-lg transition-colors ${
                      isBirthday
                        ? "bg-pink-50 border-l-4 border-pink-500 hover:bg-pink-100"
                        : "isSpecial" in event && event.isSpecial
                          ? "bg-accent-light border-l-4 border-accent-dark hover:bg-accent"
                          : "bg-warm-50 hover:bg-warm-100"
                    }`}
                  >
                    <span class="text-2xl flex-shrink-0" aria-hidden="true">
                      {event.icon}
                    </span>
                    <div class="flex-1 min-w-0">
                      <p class={`font-bold ${isBirthday ? "text-pink-900" : "text-warm-900"}`}>
                        {event.event}
                      </p>
                      <p class={`text-sm ${isBirthday ? "text-pink-800" : "text-warm-700"}`}>
                        {event.date}
                      </p>
                    </div>
                  </Tag>
                );
              })
            }
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={0.1}>
        <Calendar
          client:visible={{ rootMargin: "300px" }}
          month={events.calendar.month}
          year={events.calendar.year}
          closedDates={events.calendar.closedDates}
          specialDates={events.calendar.specialDates}
        />
      </ScrollReveal>
    </div>

    <ScrollReveal>
      <GolfTournamentAnnouncement />
    </ScrollReveal>

    <div class="bg-accent-light rounded-lg p-6 text-center">
      <p class="text-warm-900 font-semibold whitespace-pre-line">{events.note}</p>
    </div>
  </div>
</section>
