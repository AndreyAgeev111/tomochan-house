---
import type { Championship } from "../../../content/golfChampionship";
import { buildStandings } from "../../../utils/golfChampionshipUtils";

interface Props {
  championship: Championship;
}

const { championship } = Astro.props;
const isFinal =
  championship.status === "completed" &&
  championship.completedStages > 0 &&
  championship.results.length > 0;
const champion = isFinal ? buildStandings(championship)[0] : undefined;
const year = championship.season.match(/\d{4}/)?.[0] ?? championship.season;
const participants = new Set(championship.results.map((result) => result.playerId)).size;
const colors = ["#f6d57f", "#fff6da", "#dca1a3", "#b7d6be"];
const confetti = Array.from({ length: 36 }, (_, index) => ({
  left: (index * 37 + 3) % 100,
  drift: ((index * 29) % 160) - 80,
  delay: (index % 6) * 0.1,
  duration: 2.3 + (index % 5) * 0.2,
  rotation: 180 + ((index * 47) % 540),
  color: colors[index % colors.length],
}));
---

{
  champion && champion.appearances > 0 && (
    <section class="champion-section" aria-labelledby="season-champion-title">
      <div class="champion-card" data-champion-card>
        <div class="champion-effects" aria-hidden="true">
          {confetti.map((piece, index) => (
            <i
              class:list={["champion-confetti", { "is-round": index % 4 === 0 }]}
              style={`--left:${piece.left}%;--drift:${piece.drift}px;--delay:${piece.delay}s;--duration:${piece.duration}s;--rotation:${piece.rotation}deg;--color:${piece.color}`}
            />
          ))}
          {[0, 1, 2].map((firework) => (
            <div
              class={`champion-firework champion-firework-${firework}`}
              style={`--burst-delay:${0.25 + firework * 0.7}s`}
            >
              {Array.from({ length: 12 }, (_, ray) => (
                <i style={`--angle:${ray * 30}deg`} />
              ))}
            </div>
          ))}
        </div>

        <div class="champion-emblem" aria-hidden="true">
          <span class="champion-laurel champion-laurel-left">❧</span>
          <svg viewBox="0 0 100 112" fill="none" class="champion-trophy">
            <path
              d="M29 15h42v26c0 20-10 32-21 32S29 61 29 41V15Z"
              fill="url(#champion-trophy-gold)"
              stroke="#ffe6a7"
              stroke-width="2"
            />
            <path
              d="M29 23H15v14c0 15 8 23 20 23m36-37h14v14c0 15-8 23-20 23M50 73v19m-16 8h32M40 92h20v8H40z"
              stroke="#efc768"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="m50 29 3.5 7.2 8 1.2-5.8 5.6 1.4 8-7.1-3.8-7.1 3.8 1.4-8-5.8-5.6 8-1.2z"
              fill="#fff6da"
            />
            <defs>
              <linearGradient
                id="champion-trophy-gold"
                x1="29"
                y1="15"
                x2="72"
                y2="73"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#f5d88f" />
                <stop offset="1" stop-color="#b8872e" />
              </linearGradient>
            </defs>
          </svg>
          <span class="champion-laurel champion-laurel-right">❧</span>
        </div>

        <div class="champion-copy">
          <p class="champion-kicker">{year} SEASON CHAMPION</p>
          <h2 id="season-champion-title" class="champion-title">
            年間チャンピオン
          </h2>
          <p class="champion-name">
            {champion.player.shortName ?? champion.player.name}
            <span>さん</span>
          </p>
          <p class="champion-congratulations">優勝おめでとうございます！</p>

          <dl class="champion-stats">
            <div>
              <dt>獲得ポイント</dt>
              <dd>
                {champion.totalPoints}
                <span>pt</span>
              </dd>
            </div>
            <div>
              <dt>開催</dt>
              <dd>
                {championship.completedStages}
                <span>戦</span>
              </dd>
            </div>
            <div>
              <dt>参加者</dt>
              <dd>
                {participants}
                <span>名</span>
              </dd>
            </div>
          </dl>

          <p class="champion-thanks">
            一年間、たくさんのナイスショットをありがとう。
            <br />
            ご参加いただいた皆さまに、心から感謝を込めて。
          </p>
          <div class="champion-actions">
            <a href="/golf-results/#leaderboard-title" class="champion-results-link">
              シーズン最終結果を見る
            </a>
            <button type="button" data-champion-replay hidden>
              <span aria-hidden="true">🎉</span>もう一度お祝いする
            </button>
            <button type="button" data-champion-sound hidden>
              <span aria-hidden="true">♪</span>ファンファーレを鳴らす
            </button>
          </div>
          <p class="champion-wish" data-champion-wish aria-live="polite" aria-atomic="true" />
        </div>

        <div class="champion-fanfare" aria-hidden="true">
          {[0, 1].map((side) => (
            <svg
              class={`champion-trumpet champion-trumpet-${side}`}
              viewBox="0 0 96 64"
              fill="none"
            >
              <path
                d="M12 30h34l30-15v36L46 36H12z"
                fill="#edc76e"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linejoin="round"
              />
              <path
                d="M76 15h7v36h-7zM12 27H5v12h7M25 36v12c0 10 25 10 25 0v-9M28 23v7m10-7v7m-13-7h6m4 0h6m48-7 5-5m-5 21h6m-6 16 5 5"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </svg>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  import { initChampionCelebration } from "../../../utils/championCelebration";
  initChampionCelebration();
</script>

<style>
  .champion-section {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2rem 1rem;
  }

  .champion-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(8rem, 0.6fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid #c7a55e;
    border-radius: 1.5rem;
    color: #fff9e9;
    background: radial-gradient(ellipse at 10% 10%, #46695899, transparent 60%), #173e33;
    box-shadow: 0 16px 40px #173e3324;
  }

  .champion-card::after {
    content: "";
    position: absolute;
    inset: 0.5rem;
    z-index: -1;
    border: 1px solid #e9cd8e50;
    border-radius: 1rem;
    pointer-events: none;
  }

  .champion-emblem {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 11rem;
  }

  .champion-trophy {
    position: relative;
    width: clamp(7rem, 15vw, 10rem);
    filter: drop-shadow(0 8px 18px #0003);
  }

  .champion-laurel {
    position: absolute;
    top: 36%;
    color: #e4c57c;
    font-family: Georgia, serif;
    font-size: clamp(4rem, 8vw, 6.5rem);
    line-height: 1;
    opacity: 0.6;
  }

  .champion-laurel-left {
    left: -0.2rem;
    transform: rotate(-40deg);
  }
  .champion-laurel-right {
    right: -0.2rem;
    transform: scaleX(-1) rotate(-40deg);
  }
  .champion-copy {
    min-width: 0;
  }
  .champion-kicker {
    color: #f5d88f;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .champion-title {
    margin-top: 0.65rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .champion-name {
    margin-block: 0.4rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .champion-name span {
    display: inline-block;
    white-space: nowrap;
    margin-left: 0.5rem;
    font-size: 1rem;
    font-weight: 400;
  }
  .champion-congratulations {
    color: #f5d88f;
    font-size: 1rem;
  }
  .champion-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    margin-block: 1.75rem;
    padding-block: 1.25rem;
    border-block: 1px solid #f5d88f40;
  }
  .champion-stats dt {
    color: #d1dfd5;
    font-size: 0.875rem;
  }
  .champion-stats dd {
    margin-top: 0.25rem;
    color: #fff4d3;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .champion-stats dd span {
    margin-left: 0.35rem;
    font-size: 1rem;
    font-weight: 400;
  }
  .champion-thanks {
    color: #e2e9df;
    font-size: 1rem;
    line-height: 1.9;
  }
  .champion-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .champion-actions button,
  .champion-results-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 1px solid #e4c57c;
    border-radius: 999px;
    color: #fff4d3;
    background: #fff4d30a;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .champion-actions button:hover,
  .champion-results-link:hover {
    background: #fff4d31c;
  }
  .champion-actions button:focus-visible,
  .champion-results-link:focus-visible {
    outline: 3px solid #f5d88f;
    outline-offset: 4px;
  }
  .champion-actions button[hidden] {
    display: none;
  }
  .champion-wish {
    min-height: 1.6em;
    margin-top: 0.75rem;
    color: #f5d88f;
    font-size: 0.875rem;
  }
  .champion-fanfare {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    display: flex;
    justify-content: space-between;
    color: #e4c57c;
    pointer-events: none;
    opacity: 0.45;
  }
  .champion-trumpet {
    width: 3rem;
  }
  .champion-trumpet-0 {
    transform: rotate(-18deg);
  }
  .champion-trumpet-1 {
    transform: scaleX(-1) rotate(-18deg);
  }
  .champion-effects {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .champion-confetti {
    position: absolute;
    top: -1rem;
    left: var(--left);
    width: 0.4rem;
    height: 0.8rem;
    opacity: 0;
    background: var(--color);
  }
  .champion-confetti.is-round {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
  }
  .champion-firework {
    position: absolute;
    width: 0;
    height: 0;
    color: #e4c57c;
  }
  .champion-firework-0 {
    top: 18%;
    left: 12%;
  }
  .champion-firework-1 {
    top: 20%;
    right: 10%;
    color: #e1a4a4;
  }
  .champion-firework-2 {
    bottom: 25%;
    left: 28%;
  }
  .champion-firework i {
    position: absolute;
    width: 0.25rem;
    height: 0.75rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-celebrating .champion-confetti {
      animation: champion-fall var(--duration) var(--delay) ease-in forwards;
    }
    .is-celebrating .champion-firework i {
      animation: champion-burst 1.4s var(--burst-delay) ease-out forwards;
    }
    .is-celebrating .champion-trumpet-0 {
      animation: champion-fanfare-left 700ms ease-in-out 3;
    }
    .is-celebrating .champion-trumpet-1 {
      animation: champion-fanfare-right 700ms ease-in-out 3;
    }
  }

  @keyframes champion-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0);
    }
    10%,
    65% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), var(--champion-fall-distance, 700px), 0)
        rotate(var(--rotation));
    }
  }

  @keyframes champion-burst {
    0% {
      opacity: 0;
      transform: rotate(var(--angle)) translateY(-0.5rem) scaleY(0.4);
    }
    15% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: rotate(var(--angle)) translateY(-5rem) scaleY(0.6);
    }
  }

  @keyframes champion-fanfare-left {
    50% {
      transform: translateY(-5px) rotate(-28deg);
    }
  }
  @keyframes champion-fanfare-right {
    50% {
      transform: translateY(-5px) scaleX(-1) rotate(-28deg);
    }
  }

  @media (max-width: 639px) {
    .champion-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      text-align: center;
    }
    .champion-emblem {
      width: 11rem;
      min-height: 8rem;
      margin-inline: auto;
    }
    .champion-trophy {
      width: 7rem;
    }
    .champion-stats,
    .champion-actions {
      justify-content: center;
    }
    .champion-kicker {
      letter-spacing: 0.1em;
    }
    .champion-fanfare {
      top: 3rem;
      bottom: auto;
    }
    .champion-trumpet {
      width: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .champion-effects {
      display: none;
    }
  }
  @media print {
    .champion-effects,
    .champion-actions,
    .champion-wish {
      display: none;
    }
  }
</style>
