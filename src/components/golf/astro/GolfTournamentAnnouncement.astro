---
import { golfTournament2027 as event } from "../../../content/golfTournament";
import { siteContent } from "../../../content/siteContent";

interface Props {
  showSeasonLink?: boolean;
}
const { showSeasonLink = false } = Astro.props;
---

<section id={event.id} class="golf-announcement" aria-labelledby={`${event.id}-title`}>
  <div class="golf-announcement-grid">
    <a class="golf-poster-link" href={event.image} aria-label="大会ポスターを大きく見る">
      <img
        src={event.image}
        alt={event.imageAlt}
        width={event.imageWidth}
        height={event.imageHeight}
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="golf-announcement-copy">
      <p class="golf-announcement-label">2027年 最初のゴルフコンペ</p>
      <h2 id={`${event.id}-title`}>{event.title}</h2>
      <time datetime={event.isoDate}>{event.date}</time>
      <p class="golf-announcement-description">{event.description}</p>
      <dl>
        {
          event.details.map((detail) => (
            <div>
              <dt>{detail.label}</dt>
              <dd>{detail.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="golf-announcement-actions">
        <a class="golf-announcement-cta" href={siteContent.business.instagramUrl}>
          Instagramで参加申込・相談
        </a>
        <a class="golf-announcement-phone" href={`tel:${siteContent.business.phone}`}>
          電話でお問い合わせ
        </a>
      </div>
      {
        showSeasonLink && (
          <a class="golf-season-link" href="/golf-results/2027/">
            2027シーズンのページを見る
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .golf-announcement {
    margin-bottom: 3rem;
    overflow: hidden;
    border: 1px solid #d6dfd8;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 8px 28px #36574a0c;
    scroll-margin-top: 6rem;
  }
  .golf-announcement-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 2rem;
  }
  .golf-poster-link {
    display: block;
    max-width: 30rem;
    margin-inline: auto;
  }
  .golf-poster-link img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  .golf-announcement-copy {
    min-width: 0;
  }
  .golf-announcement-label {
    margin-bottom: 0.5rem;
    color: #315943;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .golf-announcement h2 {
    color: #294a38;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .golf-announcement time {
    display: block;
    margin-block: 0.75rem;
    color: #294a38;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .golf-announcement-description,
  .golf-announcement dd {
    color: #755d50;
    font-size: 1rem;
    line-height: 1.8;
  }
  .golf-announcement dl {
    margin-block: 1.5rem;
    border-top: 1px solid #d6dfd8;
  }
  .golf-announcement dl > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid #e7ece8;
  }
  .golf-announcement dt {
    color: #294a38;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.8;
  }
  .golf-announcement dd {
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .golf-announcement-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .golf-announcement-cta {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    color: #fff;
    background: #315943;
    font-size: 1rem;
    font-weight: 700;
  }
  .golf-announcement-cta:hover {
    background: #234632;
  }
  .golf-announcement-phone,
  .golf-season-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #315943;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .golf-season-link {
    margin-top: 0.75rem;
  }
  @media (max-width: 767px) {
    .golf-announcement-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1rem;
    }
    .golf-announcement dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
