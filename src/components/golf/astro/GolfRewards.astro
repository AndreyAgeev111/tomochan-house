<section aria-labelledby="rewards-title" class="border-y border-warm-200 bg-white py-8 md:py-10">
  <div class="max-w-6xl mx-auto px-4">
    <p class="text-sm font-bold tracking-wider text-green-800">POINT REWARDS</p>
    <h2 id="rewards-title" class="mt-2 text-2xl md:text-3xl font-bold text-warm-900">
      ポイント特典は近日公開！
    </h2>
    <p class="mt-2 text-sm md:text-base leading-relaxed text-warm-600">
      <JapaneseText
        phrases={[
          "獲得ポイントに応じた",
          "特典を準備中です。",
          "詳細が決まり次第",
          "お知らせしますので、",
          "お楽しみに！",
        ]}
      />
    </p>
  </div>
</section>

