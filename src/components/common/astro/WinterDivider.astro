---
import WinterTree from "./WinterTree.astro";
interface Props {
  reverse?: boolean;
}
const { reverse = false } = Astro.props;
---

<div class:list={["winter-divider", { "winter-divider-reverse": reverse }]} aria-hidden="true">
  <div class="winter-divider-inner">
    <div class="winter-divider-clearing" data-winter-clearing>
      <div class="winter-divider-tree"><WinterTree /></div>
      <div class="winter-divider-tree winter-divider-tree-small"><WinterTree /></div>
      <svg class="winter-divider-gift" viewBox="0 0 56 60" fill="none">
        <path d="M8 24h40v29H8z" fill="#934a54" stroke="#713740"></path>
        <path d="M4 18h48v12H4z" fill="#ac626b" stroke="#713740"></path>
        <path d="M24 18h8v35h-8z" fill="#e4c88a"></path>
        <path
          d="M27 18C5 19 12 1 22 9l6 9Zm2 0C51 19 44 1 34 9l-6 9Z"
          stroke="#c7a35e"
          stroke-width="3"
          stroke-linejoin="round"></path>
        <path d="M7 20h42" stroke="#fff8e9" stroke-width="3" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</div>
<style>
  .winter-divider {
    position: relative;
    z-index: 4;
    height: 11rem;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  .winter-divider-inner {
    position: relative;
    width: min(100% - 3rem, 72rem);
    height: 100%;
    margin-inline: auto;
  }
  .winter-divider-clearing {
    position: absolute;
    bottom: 0.5rem;
    left: var(--clearing-x, 50%);
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    width: max-content;
    transform: translateX(-50%) scale(var(--clearing-scale, 1));
    transform-origin: center bottom;
    visibility: hidden;
  }
  .winter-divider-clearing[data-positioned] {
    visibility: visible;
  }
  .winter-divider-clearing::before {
    content: "";
    position: absolute;
    bottom: -4px;
    left: -5%;
    z-index: -1;
    width: 110%;
    height: 1rem;
    border: 1px solid #d8e7e8;
    border-radius: 50%;
    background: #fff;
  }
  .winter-divider-tree {
    width: 4.5rem;
    height: 6.15rem;
  }
  .winter-divider-tree-small {
    width: 2.8rem;
    height: 3.8rem;
    margin-left: -1rem;
  }
  .winter-divider-gift {
    width: 3rem;
    height: 3.2rem;
    margin-inline: 0.25rem;
  }
  .winter-divider-reverse .winter-divider-clearing {
    flex-direction: row-reverse;
  }
  @media (max-width: 639px) {
    .winter-divider {
      height: 10.5rem;
    }
    .winter-divider-tree {
      width: 3.5rem;
      height: 4.8rem;
    }
    .winter-divider-tree-small {
      width: 2.2rem;
      height: 3rem;
    }
    .winter-divider-gift {
      width: 2.5rem;
      height: 2.8rem;
      margin-inline: 0;
    }
  }
  @media print {
    .winter-divider {
      display: none;
    }
  }
</style>
