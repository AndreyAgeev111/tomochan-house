---
import ScrollReveal from "./ScrollReveal.astro";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<ScrollReveal className="text-center mb-12" variant="heading">
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class="text-lg text-warm-600">{subtitle}</p>}

  <div class="section-divider"></div>
</ScrollReveal>
