---
import { siteContent } from "../../../content/siteContent";

const { nav } = siteContent;
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isGolfResults = pathname.startsWith("/golf-results");
const isGolfRules = pathname.startsWith("/golf-rules");
const isGolfPage = isGolfResults || isGolfRules;

const hrefFor = (href: string) => {
  if (!href.startsWith("#")) return href;
  if (isGolfResults) return href;
  if (isGolfRules) return `/golf-results/${href}`;
  return isHome ? href : `/${href}`;
};

const golfLink = {
  id: "golf",
  label: "ゴルフ結果",
  href: "/golf-results/",
};

const defaultNavigation = [...nav.slice(0, 4), golfLink, ...nav.slice(4)];

const golfNavigation = [
  { id: "home", label: "ホーム", href: "/" },
  { id: "top", label: "トップ3", href: "#podium-title" },
  { id: "ranking", label: "ランキング", href: "#leaderboard-title" },
  { id: "analytics", label: "推移", href: "#analytics-title" },
  { id: "rules", label: "ルール", href: "/golf-rules/" },
];

const navigation = isGolfPage ? golfNavigation : defaultNavigation;
---

<script is:inline>
  function scrollToCurrentHash() {
    if (!window.location.hash) return;

    let id;
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);

    if (!target) return;

    // Native cross-page hash restoration is inconsistent in some
    // mobile browsers. Re-run it after layout and compensate for
    // the fixed global header.
    window.requestAnimationFrame(() => {
      window.setTimeout(() => {
        const headerOffset = 84;
        const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;

        window.scrollTo({
          top: Math.max(0, top),
          behavior: "auto",
        });
      }, 0);
    });
  }

  function initMobileMenu() {
    const hamburger = document.getElementById("hamburger-btn");
    const menu = document.getElementById("mobile-menu");
    const backdrop = document.getElementById("menu-backdrop");
    const closeBtn = document.getElementById("close-btn");

    if (!hamburger || !menu || !backdrop || !closeBtn || hamburger.dataset.ready === "true") {
      return;
    }

    hamburger.dataset.ready = "true";

    function setStickyNavHidden(hidden) {
      const stickyNav = document.querySelector("[data-quick-nav]");

      if (stickyNav) {
        stickyNav.classList.toggle("hidden", hidden);
      }
    }

    function closeMenu() {
      menu.classList.add("hidden");
      backdrop.classList.add("hidden");
      hamburger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      setStickyNavHidden(false);
    }

    function toggleMenu() {
      const opening = menu.classList.contains("hidden");

      if (!opening) {
        closeMenu();
        return;
      }

      menu.classList.remove("hidden");
      backdrop.classList.remove("hidden");
      hamburger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      setStickyNavHidden(true);
      closeBtn.focus();
    }

    hamburger.addEventListener("click", toggleMenu);
    backdrop.addEventListener("click", closeMenu);
    closeBtn.addEventListener("click", closeMenu);

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
        hamburger.focus();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initMobileMenu();
      scrollToCurrentHash();
    });
  } else {
    initMobileMenu();
    scrollToCurrentHash();
  }

  window.addEventListener("load", scrollToCurrentHash);
  window.addEventListener("hashchange", scrollToCurrentHash);

  document.addEventListener("astro:after-swap", () => {
    initMobileMenu();
    scrollToCurrentHash();
  });
</script>

<header
  class="fixed top-0 left-0 right-0 z-50 bg-warm-50/95 backdrop-blur-sm border-b border-warm-200 shadow-softer"
>
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-2 group flex-shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT rounded-lg"
    >
      <img
        src="/cat-face.webp"
        alt="Tomochan logo"
        class="w-6 h-6 object-contain rounded-full border border-warm-300 shadow-sm"
      />
      <div class="flex flex-col leading-tight">
        <span class="font-bold text-sm text-warm-900"> ともちゃん家 </span>
        <span class="text-xs text-warm-700"> Tomochan House </span>
      </div>
    </a>

    <nav
      class="hidden lg:flex items-center gap-3 flex-nowrap justify-center flex-1 mx-4"
      aria-label="メインナビゲーション"
    >
      {
        navigation.map((item) => {
          const active =
            (item.id === "golf" && isGolfResults) || (item.id === "rules" && isGolfRules);

          return (
            <a
              href={hrefFor(item.href)}
              aria-current={active ? "page" : undefined}
              class={`text-sm font-medium transition-colors whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT rounded ${
                isGolfPage
                  ? item.id === "home"
                    ? "text-warm-700 hover:text-accent-dark"
                    : "text-green-800 font-bold hover:text-green-950"
                  : item.id === "golf"
                    ? "text-green-800 font-bold"
                    : "text-warm-700 hover:text-accent-dark"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a
      href={siteContent.business.instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden xl:flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-light hover:bg-accent-DEFAULT transition-colors text-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT flex-shrink-0"
    >
      <span aria-hidden="true">📱</span>
      <span>
        @{siteContent.business.instagramHandle}
      </span>
    </a>

    <button
      id="hamburger-btn"
      class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-warm-100 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="text-2xl" aria-hidden="true"> ☰ </span>
    </button>
  </div>
</header>

<div id="menu-backdrop" class="hidden lg:hidden fixed inset-0 bg-black/50 z-30"></div>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="モバイルナビゲーション"
  class="hidden lg:hidden fixed left-0 top-0 bottom-0 z-40 bg-white overflow-y-auto flex-col pt-6 shadow-lg"
  style="width: min(82vw, 28rem);"
>
  <div class="flex justify-between items-center px-6 mb-8">
    <div class="flex items-center gap-2">
      <img src="/cat-face.webp" alt="" class="w-8 h-8 object-contain" />
      <span class="font-bold text-warm-900"> ともちゃん家 </span>
    </div>

    <button
      id="close-btn"
      class="text-2xl text-warm-500 hover:text-warm-900 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT rounded p-1"
      aria-label="メニューを閉じる"
    >
      ✕
    </button>
  </div>

  <nav class="flex flex-col space-y-1 px-2 flex-1" aria-label="モバイルナビゲーション">
    {
      navigation.map((item) => {
        const active =
          (item.id === "golf" && isGolfResults) || (item.id === "rules" && isGolfRules);

        return (
          <a
            href={hrefFor(item.href)}
            aria-current={active ? "page" : undefined}
            class={`px-6 py-4 text-lg font-medium transition-colors rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT ${
              isGolfPage
                ? item.id === "home"
                  ? "text-warm-900 hover:bg-warm-50"
                  : "bg-green-50 text-green-900 font-bold hover:bg-green-100"
                : item.id === "golf"
                  ? active
                    ? "bg-green-100 text-green-950 font-bold"
                    : "bg-green-50 text-green-900 font-bold"
                  : "text-warm-900 hover:bg-warm-50"
            }`}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <div class="px-6 py-4 border-t border-warm-100">
    <a
      href={siteContent.business.instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full px-4 py-3 bg-accent-light hover:bg-accent-DEFAULT transition-colors rounded-lg font-bold text-warm-900 items-center justify-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-DEFAULT"
    >
      <span aria-hidden="true">📱</span>
      <span>
        @{siteContent.business.instagramHandle}
      </span>
    </a>
  </div>
</div>
